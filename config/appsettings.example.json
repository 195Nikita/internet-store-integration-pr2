{
  "MarketplaceApi": {
    "BaseUrl": "https://api.marketplace.example/v1",
    "ApiKeyEnvironmentVariable": "MARKETPLACE_API_KEY",
    "TimeoutSeconds": 30
  },
  "Import": {
    "InboundDirectory": "./samples",
    "AllowedExtensions": [ ".json", ".csv", ".xml" ],
    "SftpSchedule": "0 */30 * * * *"
  },
  "Storage": {
    "ConnectionStringEnvironmentVariable": "INTEGRATION_DB_CONNECTION"
  }
}
